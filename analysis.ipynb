    "        else:\n",
    "            # Use the median value for numerical columns\n",
    "            df[col] = df[col].fillna(df[col].median())\n",
    "\n",
    "# Verify that no missing values remain\n",
    "print(\"Missing values after handling:\\n\", df.isnull().sum().sum())"
